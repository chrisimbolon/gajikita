# Copy to .env for a local `docker compose up`. Never commit .env.
# On the droplet, .env is written by .github/workflows/deploy.yml from GitHub secrets.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=localhost,127.0.0.1,seegaji.com
CORS_ALLOWED_ORIGINS=http://localhost:3002
CSRF_TRUSTED_ORIGINS=http://localhost:3002
FRONTEND_BASE_URL=http://localhost:3002
DB_NAME=seegaji
DB_USER=seegaji
DB_PASSWORD=change-me
